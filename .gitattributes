# The patch is generated by bin/rerecord.sh; never hand-edit it, and never let git try to diff or
# three-way-merge the file itself.
patch/fa-modified.patch -diff -merge text eol=lf

# The locales are one huge JSON object each: diffs read better per line than as one long line.
assets/locales/*.json text eol=lf
overlay/app/client/ui/Rtl.css text eol=lf
*.sh text eol=lf
